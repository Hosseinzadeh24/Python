{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Advisor: run once",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Advisor: every 15 minutes",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--loop"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Advisor: backtest",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--backtest"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
